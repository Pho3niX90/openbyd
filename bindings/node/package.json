{
  "name": "openbyd",
  "version": "0.1.2",
  "description": "Unofficial client for the BYD overseas app API, with a Rust core",
  "keywords": [
    "byd",
    "ev",
    "vehicle",
    "telemetry"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pho3niX90/openbyd.git",
    "directory": "bindings/node"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native/*.node",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p test/tsconfig.json && node --test \"build/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
